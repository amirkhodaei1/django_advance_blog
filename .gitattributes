    # Auto detect text files and normalize line endings
* text=auto eol=lf

# Python
*.py text diff=python

# HTML
*.html text
*.htm text

# CSS
*.css text

# JavaScript
*.js text

# JSON
*.json text

# YAML
*.yml text
*.yaml text

# Markdown
*.md text

# XML
*.xml text

# Shell
*.sh text eol=lf

# Windows Batch
*.bat text eol=crlf
*.cmd text eol=crlf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text

# Icons
*.ico binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary

# Documents
*.pdf binary

# SQLite
*.sqlite3 binary
*.db binary